{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kids-story-teller",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "story-families",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "story-family-files"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "story-narration"
      }
    ],
    "consumers": [
      {
        "queue": "story-narration",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  }
}
